/* =========================================================
   CALCULAR SALDO
========================================================= */

function calcularSaldoFormulario() {

    const valorPedido =
        Number(
            document.getElementById('formValorPedido').value
        ) || 0;


    const valorFaturado =
        Number(
            document.getElementById('formValorFaturado').value
        ) || 0;


    const saldo =
        valorPedido - valorFaturado;


    document.getElementById('formSaldo').value =
        formatarMoeda(saldo);

}


/* =========================================================
   SALVAR PEDIDO
========================================================= */

async function salvarPedido() {

    const pedidoAegea =
        document
            .getElementById('formPedidoAegea')
            .value
            .trim();


    if (!pedidoAegea) {

        mostrarToast(
            'Atenção',
            'Informe o Pedido AEGEA.',
            'warning'
        );

        return;

    }


    const id =
        document.getElementById('pedidoId').value;


    const dados = {

        id: id,

        pedidoAegea: pedidoAegea,

        pedidoVanbro:
            document.getElementById('formPedidoVanbro').value.trim(),

        nf:
            document.getElementById('formNf').value.trim(),

        situacao:
            document.getElementById('formSituacao').value,

        transportadora:
            document.getElementById('formTransportadora').value,

        agendar:
            document.getElementById('formAgendar').value,

        cidade:
            document.getElementById('formCidade').value.trim(),

        uf:
            document.getElementById('formUF').value,

        endereco:
            document.getElementById('formEndereco').value.trim(),

        cep:
            document.getElementById('formCep').value.trim(),

        responsavel:
            document.getElementById('formResponsavel').value.trim(),

        dataPedido:
            document.getElementById('formDataPedido').value,

        dataNf:
            document.getElementById('formDataNf').value,

        previsaoEntrega:
            document.getElementById('formPrevisaoEntrega').value,

        dataEntrega:
            document.getElementById('formDataEntrega').value,

        valorPedido:
            document.getElementById('formValorPedido').value,

        valorFaturado:
            document.getElementById('formValorFaturado').value,

        observacoes:
            document.getElementById('formObservacoes').value.trim()

    };


    mostrarLoading(true, 'Salvando pedido...');


    try {

        const resposta =
            await api('salvar', dados);


        mostrarToast(
            'Sucesso',
            resposta.mensagem ||
            'Pedido salvo com sucesso.',
            'success'
        );


        const modal =
            bootstrap.Modal.getInstance(
                document.getElementById('modalPedido')
            );

        if (modal) {
            modal.hide();
        }


        await carregarDados();

    } catch (erro) {

        console.error(erro);

        mostrarToast(
            'Erro',
            erro.message ||
            'Não foi possível salvar o pedido.',
            'danger'
        );

    } finally {

        mostrarLoading(false);

    }

}


/* =========================================================
   DETALHES
========================================================= */

async function abrirDetalhes(id) {

    mostrarLoading(true, 'Carregando detalhes...');

    try {

        const resposta =
            await api('obter', { id });


        pedidoSelecionado =
            resposta.dados;


        if (!pedidoSelecionado) {

            throw new Error(
                'Pedido não encontrado.'
            );

        }


        renderizarDetalhes(
            pedidoSelecionado
        );


        const modal =
            bootstrap.Modal.getOrCreateInstance(
                document.getElementById('modalDetalhes')
            );


        modal.show();

    } catch (erro) {

        mostrarToast(
            'Erro',
            erro.message,
            'danger'
        );

    } finally {

        mostrarLoading(false);

    }

}


