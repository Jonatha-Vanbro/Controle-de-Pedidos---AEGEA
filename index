/* =========================================================
   CARREGAR PEDIDOS + DASHBOARD
========================================================= */

async function carregarDados() {

    mostrarLoading(true, 'Carregando pedidos...');

    try {

        const filtros = obterFiltros();

        const [resPedidos, resDashboard] = await Promise.all([

            api('dados', filtros),

            api('dashboard', filtros)

        ]);


        pedidos = resPedidos.dados || [];

        atualizarTabela();

        atualizarDashboard(
            resDashboard.dados
        );

    } catch (erro) {

        console.error(erro);

        mostrarToast(
            'Erro',
            erro.message ||
            'Não foi possível carregar os dados.',
            'danger'
        );

    } finally {

        mostrarLoading(false);

    }

}


