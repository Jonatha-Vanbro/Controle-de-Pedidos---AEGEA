<!DOCTYPE html>
<html lang="pt-BR">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">

    <title>Controle de Pedidos - AEGEA</title>

    <link rel="icon" type="image/png" href="favicon3.png">

    <!-- Bootstrap -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

    <!-- Bootstrap Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">

    <!-- Fonte -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">

    <style>

        :root {
            --azul: #1b4079;
            --azul-hover: #15345f;
            --azul-claro: #eef4fb;
            --cinza-bg: #f5f7fa;
            --cinza-borda: #dee2e6;
            --texto: #263238;
            --verde: #198754;
            --amarelo: #ffc107;
            --vermelho: #dc3545;
            --laranja: #fd7e14;
        }

        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            background: var(--cinza-bg);
            color: var(--texto);
            font-family: 'Inter', sans-serif;
            font-size: 14px;
        }

        /* =========================
           HEADER
        ========================= */

        .topbar {
            background: var(--azul);
            color: white;
            min-height: 68px;
            display: flex;
            align-items: center;
            padding: 0 24px;
            box-shadow: 0 2px 8px rgba(0,0,0,.12);
        }

        .topbar-title {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .topbar-icon {
            width: 40px;
            height: 40px;
            border-radius: 9px;
            background: rgba(255,255,255,.14);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 20px;
        }

        .topbar-title h1 {
            font-size: 19px;
            margin: 0;
            font-weight: 700;
        }

        .topbar-title small {
            opacity: .75;
            font-size: 11px;
        }

        .btn-primary {
            background: var(--azul);
            border-color: var(--azul);
        }

        .btn-primary:hover {
            background: var(--azul-hover);
            border-color: var(--azul-hover);
        }

        /* =========================
           CONTAINER
        ========================= */

        .page-container {
            padding: 24px;
            max-width: 1800px;
            margin: auto;
        }

        /* =========================
           CARDS
        ========================= */

        .section-title {
            font-size: 15px;
            font-weight: 700;
            color: #37474f;
            margin-bottom: 12px;
        }

        .kpi-card {
            background: white;
            border: 1px solid var(--cinza-borda);
            border-radius: 10px;
            padding: 18px;
            height: 100%;
            box-shadow: 0 1px 2px rgba(0,0,0,.03);
        }

        .kpi-label {
            font-size: 12px;
            color: #78909c;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: .3px;
        }

        .kpi-value {
            font-size: 25px;
            font-weight: 700;
            margin-top: 7px;
            color: #263238;
        }

        .kpi-icon {
            width: 42px;
            height: 42px;
            border-radius: 9px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 19px;
            background: var(--azul-claro);
            color: var(--azul);
        }

        .kpi-footer {
            font-size: 11px;
            color: #90a4ae;
            margin-top: 6px;
        }

        /* =========================
           FILTROS
        ========================= */

        .filter-card,
        .table-card {
            background: white;
            border: 1px solid var(--cinza-borda);
            border-radius: 10px;
            box-shadow: 0 1px 2px rgba(0,0,0,.03);
        }

        .filter-card {
            padding: 18px;
        }

        .form-label {
            font-size: 12px;
            font-weight: 600;
            color: #546e7a;
            margin-bottom: 5px;
        }

        .form-control,
        .form-select {
            font-size: 13px;
            min-height: 38px;
        }

        /* =========================
           TABELA
        ========================= */

        .table-card {
            overflow: hidden;
        }

        .table-header {
            padding: 15px 18px;
            border-bottom: 1px solid var(--cinza-borda);
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 10px;
        }

        .table-header-title {
            font-weight: 700;
            font-size: 15px;
        }

        .table-responsive {
            max-height: 68vh;
            overflow: auto;
        }

        .table {
            margin: 0;
            white-space: nowrap;
            font-size: 12px;
        }

        .table thead th {
            background: var(--azul);
            color: white;
            font-weight: 600;
            font-size: 11px;
            text-transform: uppercase;
            letter-spacing: .2px;
            padding: 11px 9px;
            border: none;
            position: sticky;
            top: 0;
            z-index: 5;
        }

        .table tbody td {
            padding: 10px 9px;
            vertical-align: middle;
            border-color: #edf0f2;
        }

        .table tbody tr:hover {
            background: #f8fbff;
        }

        .pedido-link {
            color: var(--azul);
            font-weight: 700;
            cursor: pointer;
            text-decoration: none;
        }

        .pedido-link:hover {
            text-decoration: underline;
        }

        /* =========================
           BADGES
        ========================= */

        .status-badge {
            display: inline-flex;
            align-items: center;
            padding: 5px 8px;
            border-radius: 20px;
            font-size: 10px;
            font-weight: 700;
        }

        .status-aguardando {
            background: #fff3cd;
            color: #856404;
        }

        .status-transito {
            background: #cfe2ff;
            color: #084298;
        }

        .status-entregue {
            background: #d1e7dd;
            color: #0f5132;
        }

        .status-problema {
            background: #f8d7da;
            color: #842029;
        }

        .status-cancelado {
            background: #e2e3e5;
            color: #41464b;
        }

        .status-padrao {
            background: #e9ecef;
            color: #495057;
        }

        .badge-agendar-sim {
            color: #856404;
            background: #fff3cd;
        }

        .badge-agendar-nao {
            color: #0f5132;
            background: #d1e7dd;
        }

        /* =========================
           PROGRESSO
        ========================= */

        .progress-financeiro {
            height: 7px;
            border-radius: 10px;
            background: #e9ecef;
            min-width: 90px;
        }

        .progress-financeiro .progress-bar {
            background: var(--azul);
        }

        .percentual {
            font-size: 11px;
            font-weight: 600;
            margin-top: 3px;
        }

        /* =========================
           MODAIS
        ========================= */

        .modal-header {
            background: var(--azul);
            color: white;
        }

        .modal-header .btn-close {
            filter: brightness(0) invert(1);
        }

        .modal-title {
            font-size: 16px;
            font-weight: 700;
        }

        .modal-section {
            font-size: 13px;
            font-weight: 700;
            color: var(--azul);
            border-bottom: 1px solid #e5e7eb;
            padding-bottom: 7px;
            margin-bottom: 14px;
            margin-top: 5px;
        }

        /* =========================
           DETALHES
        ========================= */

        .detail-label {
            font-size: 10px;
            text-transform: uppercase;
            color: #78909c;
            font-weight: 700;
            margin-bottom: 2px;
        }

        .detail-value {
            font-size: 13px;
            font-weight: 500;
            color: #263238;
            min-height: 20px;
        }

        .detail-box {
            background: #f8fafc;
            border: 1px solid #e9ecef;
            border-radius: 8px;
            padding: 10px;
            height: 100%;
        }

        /* =========================
           HISTÓRICO
        ========================= */

        .timeline {
            position: relative;
            padding-left: 24px;
        }

        .timeline::before {
            content: "";
            position: absolute;
            left: 7px;
            top: 4px;
            bottom: 4px;
            width: 2px;
            background: #dce4eb;
        }

        .timeline-item {
            position: relative;
            padding-bottom: 18px;
        }

        .timeline-item::before {
            content: "";
            position: absolute;
            left: -21px;
            top: 3px;
            width: 10px;
            height: 10px;
            border-radius: 50%;
            background: var(--azul);
            border: 2px solid white;
            box-shadow: 0 0 0 2px #cbd7e2;
        }

        .timeline-date {
            font-size: 10px;
            color: #90a4ae;
        }

        .timeline-event {
            font-size: 12px;
            font-weight: 700;
            margin-top: 2px;
        }

        .timeline-description {
            font-size: 11px;
            color: #607d8b;
            margin-top: 2px;
        }

        /* =========================
           LOADING
        ========================= */

        .loading-overlay {
            position: fixed;
            inset: 0;
            background: rgba(255,255,255,.78);
            z-index: 9999;
            display: none;
            align-items: center;
            justify-content: center;
            flex-direction: column;
            gap: 10px;
        }

        .loading-overlay.show {
            display: flex;
        }

        .spinner-border {
            color: var(--azul);
        }

        /* =========================
           TOAST
        ========================= */

        .toast-container {
            z-index: 10000;
        }

        /* =========================
           RESPONSIVO
        ========================= */

        @media (max-width: 768px) {

            .topbar {
                padding: 12px 15px;
            }

            .page-container {
                padding: 15px;
            }

            .topbar-title h1 {
                font-size: 16px;
            }

            .kpi-value {
                font-size: 21px;
            }

            .table-responsive {
                max-height: 65vh;
            }
        }

    </style>
</head>

<body>

<!-- =========================
     LOADING
========================= -->

<div class="loading-overlay" id="loadingOverlay">
    <div class="spinner-border" role="status"></div>
    <div id="loadingText">Carregando...</div>
</div>


<!-- =========================
     HEADER
========================= -->

<header class="topbar">

    <div class="topbar-title">

        <div class="topbar-icon">
            <i class="bi bi-truck"></i>
        </div>

        <div>
            <h1>Controle de Pedidos AEGEA</h1>
            <small>Gestão de pedidos, entregas e execução financeira</small>
        </div>

    </div>

    <div class="ms-auto d-flex gap-2">

        <button
            class="btn btn-light btn-sm"
            onclick="carregarDados()"
            title="Atualizar dados">

            <i class="bi bi-arrow-clockwise"></i>
            <span class="d-none d-md-inline">Atualizar</span>

        </button>

        <button
            class="btn btn-light btn-sm"
            onclick="abrirModalNovoPedido()">

            <i class="bi bi-plus-lg"></i>
            Novo pedido

        </button>

    </div>

</header>


<main class="page-container">

    <!-- =========================
         FINANCEIRO
    ========================= -->

    <div class="section-title">
        <i class="bi bi-cash-stack me-1"></i>
        Visão financeira
    </div>

    <div class="row g-3 mb-4">

        <div class="col-12 col-md-6 col-xl-3">

            <div class="kpi-card">

                <div class="d-flex justify-content-between">

                    <div>
                        <div class="kpi-label">Total em pedidos</div>
                        <div class="kpi-value" id="kpiTotalPedidos">R$ 0,00</div>
                        <div class="kpi-footer">Valor total dos pedidos filtrados</div>
                    </div>

                    <div class="kpi-icon">
                        <i class="bi bi-receipt"></i>
                    </div>

                </div>

            </div>

        </div>


        <div class="col-12 col-md-6 col-xl-3">

            <div class="kpi-card">

                <div class="d-flex justify-content-between">

                    <div>
                        <div class="kpi-label">Total faturado</div>
                        <div class="kpi-value text-success" id="kpiTotalFaturado">
                            R$ 0,00
                        </div>
                        <div class="kpi-footer">Valor já faturado</div>
                    </div>

                    <div class="kpi-icon">
                        <i class="bi bi-check-circle"></i>
                    </div>

                </div>

            </div>

        </div>


        <div class="col-12 col-md-6 col-xl-3">

            <div class="kpi-card">

                <div class="d-flex justify-content-between">

                    <div>
                        <div class="kpi-label">Saldo a faturar</div>
                        <div class="kpi-value text-warning" id="kpiSaldoFaturar">
                            R$ 0,00
                        </div>
                        <div class="kpi-footer">Valor ainda não faturado</div>
                    </div>

                    <div class="kpi-icon">
                        <i class="bi bi-hourglass-split"></i>
                    </div>

                </div>

            </div>

        </div>


        <div class="col-12 col-md-6 col-xl-3">

            <div class="kpi-card">

                <div class="d-flex justify-content-between">

                    <div>
                        <div class="kpi-label">Execução financeira</div>
                        <div class="kpi-value" id="kpiExecucao">0%</div>
                        <div class="kpi-footer">Faturado / valor dos pedidos</div>
                    </div>

                    <div class="kpi-icon">
                        <i class="bi bi-graph-up-arrow"></i>
                    </div>

                </div>

            </div>

        </div>

    </div>


    <!-- =========================
         OPERACIONAL
    ========================= -->

    <div class="section-title">
        <i class="bi bi-box-seam me-1"></i>
        Visão operacional
    </div>

    <div class="row g-3 mb-4">

        <div class="col-6 col-md-4 col-xl">

            <div class="kpi-card">

                <div class="kpi-label">Total</div>

                <div class="kpi-value" id="kpiOperacionalTotal">
                    0
                </div>

                <div class="kpi-footer">Pedidos</div>

            </div>

        </div>


        <div class="col-6 col-md-4 col-xl">

            <div class="kpi-card">

                <div class="kpi-label">Aguardando</div>

                <div class="kpi-value text-warning" id="kpiAguardando">
                    0
                </div>

                <div class="kpi-footer">Aguardando envio</div>

            </div>

        </div>


        <div class="col-6 col-md-4 col-xl">

            <div class="kpi-card">

                <div class="kpi-label">Em trânsito</div>

                <div class="kpi-value text-primary" id="kpiTransito">
                    0
                </div>

                <div class="kpi-footer">Em transporte</div>

            </div>

        </div>


        <div class="col-6 col-md-4 col-xl">

            <div class="kpi-card">

                <div class="kpi-label">Entregues</div>

                <div class="kpi-value text-success" id="kpiEntregues">
                    0
                </div>

                <div class="kpi-footer">Pedidos entregues</div>

            </div>

        </div>


        <div class="col-6 col-md-4 col-xl">

            <div class="kpi-card">

                <div class="kpi-label">Problemas</div>

                <div class="kpi-value text-danger" id="kpiProblemas">
                    0
                </div>

                <div class="kpi-footer">Problemas na entrega</div>

            </div>

        </div>


        <div class="col-6 col-md-4 col-xl">

            <div class="kpi-card">

                <div class="kpi-label">Atrasadas</div>

                <div class="kpi-value text-danger" id="kpiAtrasadas">
                    0
                </div>

                <div class="kpi-footer">Fora do prazo</div>

            </div>

        </div>

    </div>


    <!-- =========================
         FILTROS
    ========================= -->

    <div class="filter-card mb-4">

        <div class="d-flex justify-content-between align-items-center mb-3">

            <div class="section-title mb-0">
                <i class="bi bi-funnel me-1"></i>
                Filtros
            </div>

            <button
                class="btn btn-sm btn-outline-secondary"
                onclick="limparFiltros()">

                <i class="bi bi-x-circle"></i>
                Limpar filtros

            </button>

        </div>


        <div class="row g-3">

            <!-- Busca -->

            <div class="col-12 col-lg-3">

                <label class="form-label">Busca</label>

                <input
                    type="text"
                    id="filtroBusca"
                    class="form-control"
                    placeholder="Pedido, NF, cidade, endereço...">

            </div>


            <!-- Situação -->

            <div class="col-6 col-lg-2">

                <label class="form-label">Situação</label>

                <select id="filtroSituacao" class="form-select">

                    <option value="">Todas</option>

                </select>

            </div>


            <!-- Transportadora -->

            <div class="col-6 col-lg-2">

                <label class="form-label">Transportadora</label>

                <select id="filtroTransportadora" class="form-select">

                    <option value="">Todas</option>

                </select>

            </div>


            <!-- UF -->

            <div class="col-6 col-lg-1">

                <label class="form-label">UF</label>

                <select id="filtroUF" class="form-select">

                    <option value="">Todas</option>

                </select>

            </div>


            <!-- Cidade -->

            <div class="col-6 col-lg-2">

                <label class="form-label">Cidade</label>

                <input
                    type="text"
                    id="filtroCidade"
                    class="form-control"
                    placeholder="Cidade">

            </div>


            <!-- Agendar -->

            <div class="col-6 col-lg-2">

                <label class="form-label">Agendar?</label>

                <select id="filtroAgendar" class="form-select">

                    <option value="">Todos</option>

                </select>

            </div>


            <!-- Campo de data -->

            <div class="col-6 col-lg-2">

                <label class="form-label">Período baseado em</label>

                <select id="filtroCampoData" class="form-select">

                    <option value="">Sem período</option>
                    <option value="pedido">Data do pedido</option>
                    <option value="nf">Data da NF</option>
                    <option value="previsao">Previsão de entrega</option>
                    <option value="entrega">Data de entrega</option>

                </select>

            </div>


            <!-- Data inicial -->

            <div class="col-6 col-lg-2">

                <label class="form-label">Data inicial</label>

                <input
                    type="date"
                    id="filtroDataInicio"
                    class="form-control">

            </div>


            <!-- Data final -->

            <div class="col-6 col-lg-2">

                <label class="form-label">Data final</label>

                <input
                    type="date"
                    id="filtroDataFim"
                    class="form-control">

            </div>


            <!-- Botão -->

            <div class="col-12 col-lg-2 d-flex align-items-end">

                <button
                    class="btn btn-primary w-100"
                    onclick="aplicarFiltros()">

                    <i class="bi bi-search"></i>
                    Filtrar

                </button>

            </div>

        </div>

    </div>


    <!-- =========================
         TABELA
    ========================= -->

    <div class="table-card">

        <div class="table-header">

            <div>

                <div class="table-header-title">
                    Pedidos AEGEA
                </div>

                <small class="text-muted" id="contadorPedidos">
                    0 pedidos
                </small>

            </div>

            <button
                class="btn btn-primary btn-sm"
                onclick="abrirModalNovoPedido()">

                <i class="bi bi-plus-lg"></i>
                Novo pedido

            </button>

        </div>


        <div class="table-responsive">

            <table class="table table-hover">

                <thead>

                    <tr>

                        <th>Pedido AEGEA</th>
                        <th>Pedido VANBRO</th>
                        <th>NF</th>
                        <th>Cidade / UF</th>
                        <th>Transportadora</th>
                        <th>Situação</th>
                        <th>Agendar</th>
                        <th>Previsão</th>
                        <th>Entrega</th>
                        <th>Valor</th>
                        <th>Faturado</th>
                        <th>Saldo</th>
                        <th>Execução</th>
                        <th>Ações</th>

                    </tr>

                </thead>

                <tbody id="tabelaPedidos">

                </tbody>

            </table>

        </div>

    </div>

</main>


<!-- =========================================================
     MODAL - CADASTRO / EDIÇÃO
========================================================= -->

<div class="modal fade" id="modalPedido" tabindex="-1">

    <div class="modal-dialog modal-xl modal-dialog-scrollable">

        <div class="modal-content">

            <div class="modal-header">

                <h5 class="modal-title" id="modalPedidoTitulo">
                    Novo pedido
                </h5>

                <button
                    type="button"
                    class="btn-close"
                    data-bs-dismiss="modal">
                </button>

            </div>


            <div class="modal-body">

                <input type="hidden" id="pedidoId">


                <!-- IDENTIFICAÇÃO -->

                <div class="modal-section">
                    <i class="bi bi-file-earmark-text me-1"></i>
                    Identificação
                </div>

                <div class="row g-3 mb-4">

                    <div class="col-md-4">

                        <label class="form-label">
                            Pedido AEGEA *
                        </label>

                        <input
                            type="text"
                            id="formPedidoAegea"
                            class="form-control"
                            required>

                    </div>


                    <div class="col-md-4">

                        <label class="form-label">
                            Pedido VANBRO
                        </label>

                        <input
                            type="text"
                            id="formPedidoVanbro"
                            class="form-control">

                    </div>


                    <div class="col-md-4">

                        <label class="form-label">
                            NF
                        </label>

                        <input
                            type="text"
                            id="formNf"
                            class="form-control">

                    </div>

                </div>


                <!-- SITUAÇÃO -->

                <div class="row g-3 mb-4">

                    <div class="col-md-4">

                        <label class="form-label">
                            Situação
                        </label>

                        <select
                            id="formSituacao"
                            class="form-select">
                        </select>

                    </div>


                    <div class="col-md-4">

                        <label class="form-label">
                            Transportadora
                        </label>

                        <select
                            id="formTransportadora"
                            class="form-select">
                        </select>

                    </div>


                    <div class="col-md-4">

                        <label class="form-label">
                            Agendar?
                        </label>

                        <select
                            id="formAgendar"
                            class="form-select">
                        </select>

                    </div>

                </div>


                <!-- ENTREGA -->

                <div class="modal-section">
                    <i class="bi bi-geo-alt me-1"></i>
                    Local de entrega
                </div>

                <div class="row g-3 mb-4">

                    <div class="col-md-5">

                        <label class="form-label">
                            Cidade
                        </label>

                        <input
                            type="text"
                            id="formCidade"
                            class="form-control">

                    </div>


                    <div class="col-md-2">

                        <label class="form-label">
                            UF
                        </label>

                        <select
                            id="formUF"
                            class="form-select">
                        </select>

                    </div>


                    <div class="col-md-5">

