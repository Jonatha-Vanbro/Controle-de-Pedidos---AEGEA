/* =========================================================
   SITUAÇÃO
========================================================= */

async function abrirModalSituacao(id) {

    try {

        const resposta =
            await api('obter', { id });


        pedidoSelecionado =
            resposta.dados;


        document.getElementById('situacaoPedidoId').value =
            id;


        document.getElementById('novaSituacao').value =
            pedidoSelecionado.situacao || '';


        document.getElementById('observacaoSituacao').value =
            '';


        const modalDetalhes =
            bootstrap.Modal.getInstance(
                document.getElementById('modalDetalhes')
            );

        if (modalDetalhes) {
            modalDetalhes.hide();
        }


        const modal =
            bootstrap.Modal.getOrCreateInstance(
                document.getElementById('modalSituacao')
            );

        modal.show();

    } catch (erro) {

        mostrarToast(
            'Erro',
            erro.message,
            'danger'
        );

    }

}


/* =========================================================
   SALVAR SITUAÇÃO
========================================================= */

async function salvarSituacao() {

    const id =
        document.getElementById('situacaoPedidoId').value;


    const situacao =
        document.getElementById('novaSituacao').value;


    const observacao =
        document
            .getElementById('observacaoSituacao')
            .value
            .trim();


    if (!id || !situacao) {

        mostrarToast(
            'Atenção',
            'Informe a nova situação.',
            'warning'
        );

        return;

    }


    mostrarLoading(true, 'Atualizando situação...');


    try {

        const resposta =
            await api('situacao', {

                id: id,

                novaSituacao: situacao,

                observacao: observacao

            });


        mostrarToast(
            'Sucesso',
            resposta.mensagem ||
            'Situação atualizada.',
            'success'
        );


        const modal =
            bootstrap.Modal.getInstance(
                document.getElementById('modalSituacao')
            );

        if (modal) {
            modal.hide();
        }


        await carregarDados();

    } catch (erro) {

        mostrarToast(
            'Erro',
            erro.message,
            'danger'
        );

    } finally {

        mostrarLoading(false);

    }

}


/* =========================================================
   EXCLUIR
========================================================= */

async function excluirPedido(id) {

    const pedido =
        pedidos.find(p => p.id === id);


    const identificacao =
        pedido
            ? pedido.pedidoAegea
            : id;


    const confirmar =
        confirm(
            `Deseja realmente excluir o pedido AEGEA ${identificacao}?\n\n` +
            `Esta operação não poderá ser desfeita.`
        );


    if (!confirmar) {
        return;
    }


    mostrarLoading(true, 'Excluindo pedido...');


    try {

        const resposta =
            await api('excluir', {

                id: id

            });


        mostrarToast(
            'Sucesso',
            resposta.mensagem ||
            'Pedido excluído.',
            'success'
        );


        await carregarDados();

    } catch (erro) {

        mostrarToast(
            'Erro',
            erro.message,
            'danger'
        );

    } finally {

        mostrarLoading(false);

    }

}


/* =========================================================
   HISTÓRICO
========================================================= */

async function abrirHistorico(id) {

    const container =
        document.getElementById('historicoConteudo');


    container.innerHTML = `

        <div class="text-center py-4">

            <div class="spinner-border spinner-border-sm"></div>

            <div class="mt-2 text-muted">
                Carregando histórico...
            </div>

        </div>

    `;


    const modal =
        bootstrap.Modal.getOrCreateInstance(
            document.getElementById('modalHistorico')
        );


    modal.show();


    try {

        const resposta =
            await api('historico', {

                idPedido: id

            });


        const historico =
            resposta.dados || [];


        if (!historico.length) {

            container.innerHTML = `

                <div class="text-center py-5 text-muted">

                    <i class="bi bi-clock-history fs-2 d-block mb-2"></i>

                    Nenhum histórico registrado.

                </div>

            `;

            return;

        }


        container.innerHTML = `

            <div class="timeline">

                ${historico.map(item => `

                    <div class="timeline-item">

                        <div class="timeline-date">

                            ${formatarDataHora(item.dataHora)}

                        </div>


                        <div class="timeline-event">

                            ${escaparHtml(item.evento || '-')}

                        </div>


                        <div class="timeline-description">

                            ${
                                item.situacaoAnterior
                                    ? `Situação: ${escaparHtml(item.situacaoAnterior)} → ${escaparHtml(item.situacaoNova || '')}`
                                    : ''
                            }

                        </div>


                        ${
                            item.observacao
                                ? `
                                    <div class="timeline-description mt-1">
                                        <strong>Obs.:</strong>
                                        ${nl2br(escaparHtml(item.observacao))}
                                    </div>
                                  `
                                : ''
                        }


                        ${
                            item.usuario
                                ? `
                                    <div class="timeline-date mt-1">
                                        Usuário: ${escaparHtml(item.usuario)}
                                    </div>
                                  `
                                : ''
                        }

                    </div>

                `).join('')}

            </div>

        `;

    } catch (erro) {

        container.innerHTML = `

            <div class="alert alert-danger">

                <i class="bi bi-exclamation-triangle me-1"></i>

                ${escaparHtml(erro.message)}

            </div>

        `;

    }

}


/* =========================================================
   BADGE SITUAÇÃO
========================================================= */

function criarBadgeSituacao(situacao) {

    if (!situacao) {

        return `
            <span class="status-badge status-padrao">
                -
            </span>
        `;

    }


    let classe =
        'status-padrao';


    const texto =
        situacao.toLowerCase();


    if (texto.includes('aguardando')) {

        classe =
            'status-aguardando';

    } else if (
        texto.includes('trânsito') ||
        texto.includes('transito')
    ) {

        classe =
            'status-transito';

    } else if (
        texto.includes('entregue')
    ) {

        classe =
            'status-entregue';

    } else if (
        texto.includes('problema')
    ) {

        classe =
            'status-problema';

    } else if (
        texto.includes('cancelado')
    ) {

        classe =
            'status-cancelado';

    }


    return `

        <span class="status-badge ${classe}">

            ${escaparHtml(situacao)}

        </span>

    `;

}


/* =========================================================
   BADGE AGENDAR
========================================================= */

function criarBadgeAgendar(valor) {

    if (!valor) {
        return '-';
    }


    const classe =
        String(valor).toLowerCase() === 'sim'
            ? 'badge-agendar-sim'
            : 'badge-agendar-nao';


    return `

        <span class="status-badge ${classe}">

            ${escaparHtml(valor)}

        </span>

    `;

}


/* =========================================================
   FORMATAÇÕES
========================================================= */

function formatarMoeda(valor) {

    const numero =
        Number(valor || 0);


    return numero.toLocaleString(
        'pt-BR',
        {
            style: 'currency',
            currency: 'BRL'
        }
    );

}


function formatarPercentual(valor) {

    let numero =
        Number(valor || 0);


    if (numero <= 1) {
        numero *= 100;
    }


    return numero.toLocaleString(
        'pt-BR',
        {
            minimumFractionDigits: 1,
            maximumFractionDigits: 1
        }
    ) + '%';

}


function formatarData(valor) {

    if (!valor) {
        return '-';
    }


    const data =
        converterData(valor);


    if (!data) {
        return '-';
    }


    return data.toLocaleDateString(
        'pt-BR'
    );

}


function formatarDataHora(valor) {

    if (!valor) {
        return '-';
    }


    const data =
        converterData(valor);


    if (!data) {
        return '-';
    }


    return data.toLocaleDateString(
        'pt-BR'
    ) +
    ' ' +
    data.toLocaleTimeString(
        'pt-BR',
        {
            hour: '2-digit',
            minute: '2-digit'
        }
    );

}


function converterData(valor) {

    if (!valor) {
        return null;
    }


    if (valor instanceof Date) {
        return valor;
    }


    let texto =
        String(valor);


    /*
       Trata o formato:
       yyyy-MM-dd'T'HH:mm:ss
    */

    if (
        /^\d{4}-\d{2}-\d{2}T/.test(texto)
    ) {

        const data =
            new Date(texto);

        if (!isNaN(data.getTime())) {
            return data;
        }

    }


    /*
       Trata yyyy-MM-dd
    */

    if (
        /^\d{4}-\d{2}-\d{2}$/.test(texto)
    ) {

        const partes =
            texto.split('-');

        return new Date(
            Number(partes[0]),
            Number(partes[1]) - 1,
            Number(partes[2])
        );

    }


    const data =
        new Date(texto);


    if (isNaN(data.getTime())) {
        return null;
    }


    return data;

}


function paraInputDate(valor) {

    if (!valor) {
        return '';
    }


    const data =
        converterData(valor);


    if (!data) {
        return '';
    }


    const ano =
        data.getFullYear();


    const mes =
        String(
            data.getMonth() + 1
        ).padStart(2, '0');


    const dia =
        String(
            data.getDate()
        ).padStart(2, '0');


    return `${ano}-${mes}-${dia}`;

}


/* =========================================================
   UTILITÁRIOS
========================================================= */

function escaparHtml(valor) {

    return String(valor ?? '')
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#039;');

}


function escaparJs(valor) {

    return String(valor ?? '')
        .replace(/\\/g, '\\\\')
        .replace(/'/g, "\\'")
        .replace(/"/g, '\\"')
        .replace(/\n/g, '\\n')
        .replace(/\r/g, '\\r');

}


function nl2br(texto) {

    return String(texto)
        .replace(/\n/g, '<br>');

}


/* =========================================================
   LOADING
========================================================= */

function mostrarLoading(exibir, texto = 'Carregando...') {

    const overlay =
        document.getElementById('loadingOverlay');


    document.getElementById('loadingText').textContent =
        texto;


    if (exibir) {

        overlay.classList.add('show');

    } else {

        overlay.classList.remove('show');

    }

}


/* =========================================================
   TOAST
========================================================= */

function mostrarToast(
    titulo,
    texto,
    tipo = 'info'
) {

    const toastElement =
        document.getElementById('toastMensagem');


    const tituloElement =
        document.getElementById('toastTitulo');


    const textoElement =
        document.getElementById('toastTexto');


    const icon =
        document.getElementById('toastIcon');


    tituloElement.textContent =
        titulo;


    textoElement.textContent =
        texto;


    toastElement.classList.remove(
        'text-bg-success',
        'text-bg-danger',
        'text-bg-warning',
        'text-bg-info'
    );


    icon.className =
        'bi me-2';


    if (tipo === 'success') {

        toastElement.classList.add(
            'text-bg-success'
        );

        icon.classList.add(
            'bi-check-circle'
        );

    } else if (tipo === 'danger') {

        toastElement.classList.add(
            'text-bg-danger'
        );

        icon.classList.add(
            'bi-exclamation-triangle'
        );

    } else if (tipo === 'warning') {

        toastElement.classList.add(
            'text-bg-warning'
        );

        icon.classList.add(
            'bi-exclamation-circle'
        );

    } else {

        toastElement.classList.add(
            'text-bg-info'
        );

        icon.classList.add(
            'bi-info-circle'
        );

    }


    const toast =
        bootstrap.Toast.getOrCreateInstance(
            toastElement,
            {
                delay: 3500
            }
        );


    toast.show();

}

