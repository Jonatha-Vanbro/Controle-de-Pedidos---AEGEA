/* =========================================================
   API JSONP
========================================================= */

function api(acao, params = {}) {

    return new Promise((resolve, reject) => {

        const callbackName =
            'jsonp_' +
            Date.now() +
            '_' +
            Math.floor(Math.random() * 100000);


        const script = document.createElement('script');

        const query = new URLSearchParams();

        query.append('acao', acao);
        query.append('callback', callbackName);


        Object.keys(params).forEach(key => {

            const valor = params[key];

            if (
                valor !== undefined &&
                valor !== null &&
                valor !== ''
            ) {

                query.append(key, valor);

            }

        });


        const timeout = setTimeout(() => {

            cleanup();

            reject(
                new Error('Tempo limite excedido ao acessar o servidor.')
            );

        }, 30000);


        function cleanup() {

            clearTimeout(timeout);

            if (script.parentNode) {
                script.parentNode.removeChild(script);
            }

            try {
                delete window[callbackName];
            } catch (e) {
                window[callbackName] = undefined;
            }

        }


        window[callbackName] = function (resposta) {

            cleanup();

            if (!resposta) {

                reject(
                    new Error('Resposta vazia do servidor.')
                );

                return;
            }


            if (resposta.sucesso === false) {

                reject(
                    new Error(
                        resposta.mensagem ||
                        'O servidor retornou um erro.'
                    )
                );

                return;
            }


            resolve(resposta);

        };


        script.onerror = function () {

            cleanup();

            reject(
                new Error(
                    'Não foi possível conectar ao Apps Script.'
                )
            );

        };


        script.src =
            API_URL +
            '?' +
            query.toString();


        document.body.appendChild(script);

    });

}


