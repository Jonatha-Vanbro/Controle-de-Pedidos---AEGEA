    limparFormularioPedido();


    if (listas.situacoes.length) {

        document.getElementById('formSituacao').value =
            listas.situacoes.includes('Aguardando envio')
                ? 'Aguardando envio'
                : listas.situacoes[0];

    }


    if (listas.agendamento.length) {

        document.getElementById('formAgendar').value =
            listas.agendamento.includes('Não')
                ? 'Não'
                : listas.agendamento[0];

    }


    const modal =
        bootstrap.Modal.getOrCreateInstance(
            document.getElementById('modalPedido')
        );

    modal.show();

}


/* =========================================================
   EDITAR PEDIDO
========================================================= */

async function editarPedido(id) {

    mostrarLoading(true, 'Carregando pedido...');

    try {

        const resposta =
            await api('obter', { id });

        const pedido =
            resposta.dados;


        if (!pedido) {

            throw new Error(
                'Pedido não encontrado.'
            );

        }


        pedidoSelecionado = pedido;

        preencherFormularioPedido(pedido);


        document.getElementById('modalPedidoTitulo').textContent =
            'Editar pedido';


        const modalDetalhes =
            bootstrap.Modal.getInstance(
                document.getElementById('modalDetalhes')
            );

        if (modalDetalhes) {
            modalDetalhes.hide();
        }


        const modal =
            bootstrap.Modal.getOrCreateInstance(
                document.getElementById('modalPedido')
            );

        modal.show();

    } catch (erro) {

        mostrarToast(
            'Erro',
            erro.message,
            'danger'
        );

    } finally {

        mostrarLoading(false);

    }

}


